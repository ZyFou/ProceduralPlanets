{
  "name": "procedural-planets",
  "version": "0.2.0",
  "description": "Procedural planets, gas giants and stars for three.js: GPU terrain with quadtree LOD, volumetric clouds, analytic oceans, physically based atmospheres — as objects you add to your own scene.",
  "keywords": [
    "three",
    "threejs",
    "planet",
    "procedural",
    "webgl",
    "terrain",
    "atmosphere",
    "clouds",
    "gas-giant",
    "star",
    "space"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/lib/procedural-planets.js",
  "module": "./dist/lib/procedural-planets.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/lib/procedural-planets.js"
    },
    "./export": {
      "types": "./types/export.d.ts",
      "import": "./dist/lib/export.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "types",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:studio",
    "build:lib": "vite build -c vite.lib.config.js",
    "build:studio": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "docs:params": "node scripts/gen-param-docs.mjs",
    "docs:check": "node scripts/gen-param-docs.mjs --check",
    "prepublishOnly": "npm run docs:check && npm test && npm run build:lib"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
